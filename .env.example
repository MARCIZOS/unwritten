# Copy to .env.local and fill in from Firebase console > Project settings > Your apps > Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check: reCAPTCHA Enterprise site key (Firebase console > App Check > your web app).
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Local development only: "true" makes App Check print a debug token in the browser console.
# Register that token in Firebase console > App Check > Manage debug tokens. Never set this in production.
VITE_APPCHECK_DEBUG=true

# Local development only: "true" points Auth and Firestore at the Firebase emulators
# (run `firebase emulators:start`). AI Logic always uses the real project.
VITE_USE_EMULATORS=false
